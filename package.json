{
  "name": "@canonry/agent-readiness",
  "version": "8.0.1",
  "description": "Website agent readiness audit. Scores how well AI agents and answer engines can reach, read, and cite a site across 16 factors, from a CLI, library, agent skill, or CI gate.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-readiness": "bin/agent-readiness.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scoring": {
      "types": "./dist/scoring.d.ts",
      "default": "./dist/scoring.js"
    },
    "./compare": {
      "types": "./dist/compare.d.ts",
      "default": "./dist/compare.js"
    },
    "./analyzers/*": {
      "types": "./dist/analyzers/*.d.ts",
      "default": "./dist/analyzers/*.js"
    },
    "./formatters/*": {
      "types": "./dist/formatters/*.d.ts",
      "default": "./dist/formatters/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist/",
    "bin/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "pnpm run build",
    "test:e2e": "tsx --test test/e2e/*.test.ts",
    "lint": "eslint src/ test/ bin/ eslint.config.js",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run test:e2e && pnpm run lint"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "ipaddr.js": "^2.3.0",
    "undici": "^7.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.5.1",
    "eslint": "^9.0.0",
    "globals": "^17.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent-readiness",
    "ai-agents",
    "ai-crawlers",
    "aeo",
    "geo",
    "answer-engine-optimization",
    "seo",
    "ai-seo",
    "llmo",
    "structured-data",
    "json-ld",
    "llms-txt",
    "claude-code",
    "skill",
    "audit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Canonry/agent-readiness.git"
  },
  "homepage": "https://canonry.ai",
  "bugs": {
    "url": "https://github.com/Canonry/agent-readiness/issues"
  }
}
